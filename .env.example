# FortiSales AI - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.

# Application Configuration
APP_NAME="FortiSales AI"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/v1"
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="fortisales_user"
POSTGRES_PASSWORD="REPLACE_WITH_SECURE_PASSWORD"
POSTGRES_DB="fortisales_db"

# Asynchronous and Synchronous Database URLs
# For async FastAPI / SQLAlchemy: postgresql+asyncpg://user:pass@host:port/db
# For Alembic migrations: postgresql+psycopg2://user:pass@host:port/db
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"
SYNC_DATABASE_URL="postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
